{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fleet Cluster LLD Documentation",
  "type": "object",
  "required": ["metadata", "sections"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["cluster_name", "title", "generated"],
      "properties": {
        "cluster_name": { "type": "string", "description": "Cluster name as it appears in clusters/" },
        "title": { "type": "string", "description": "Human-readable LLD title" },
        "generated": { "type": "string", "format": "date-time" },
        "ocp_version": { "type": "string", "description": "OCP version and channel" },
        "role": { "type": "string", "enum": ["hub", "managed"] },
        "generator": { "type": "string", "description": "Tool or skill that generated this document" }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "title", "type", "content"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "type": { "const": "text" },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "title", "type"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "type": { "const": "config-summary" },
              "content": { "type": "string" },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["resource", "field", "value", "rationale"],
                  "properties": {
                    "resource": { "type": "string" },
                    "field": { "type": "string" },
                    "value": {},
                    "rationale": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "title", "type", "diagram_type", "content"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "type": { "const": "diagram" },
              "diagram_type": { "type": "string", "enum": ["mermaid"] },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "title", "type", "columns", "rows"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "type": { "const": "table" },
              "columns": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array" } }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}

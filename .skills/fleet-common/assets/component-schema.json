{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fleet Component Documentation",
  "type": "object",
  "required": ["component", "title", "generated", "sections"],
  "properties": {
    "component": { "type": "string", "description": "Base component name (kebab-case)" },
    "title": { "type": "string", "description": "Human-readable display name" },
    "generated": { "type": "string", "format": "date-time" },
    "upstream": {
      "type": "object",
      "properties": {
        "product": { "type": "string" },
        "docs_url": { "type": "string", "format": "uri" },
        "operator": { "type": "string" },
        "channel": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "lifecycle_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "wave", "purpose"],
        "properties": {
          "name": { "type": "string" },
          "wave": { "type": "integer" },
          "purpose": { "type": "string" }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "title", "body"],
            "properties": {
              "type": { "const": "text" },
              "title": { "type": "string" },
              "body": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "title"],
            "properties": {
              "type": { "const": "config-summary" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["resource", "field", "value", "rationale"],
                  "properties": {
                    "resource": { "type": "string" },
                    "field": { "type": "string" },
                    "value": {},
                    "rationale": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "title", "mermaid"],
            "properties": {
              "type": { "const": "diagram" },
              "title": { "type": "string" },
              "mermaid": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "title", "columns", "rows"],
            "properties": {
              "type": { "const": "table" },
              "title": { "type": "string" },
              "columns": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array" } }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
